{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "outDir": ".audit-dist"
  },
  "include": [
    "src/lib/bakingMath.ts",
    "src/lib/units.ts",
    "src/types/baking.ts",
    "tests/**/*.ts"
  ]
}
